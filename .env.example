# =============================================================================
# Intelligent Fine-Grained Vehicle Recognition System - Environment Variables
# =============================================================================
# Copy this file to .env and configure for your local environment.
# Note: .env is ignored by Git and should never be committed with credentials.

# Path to the Stanford Cars dataset directory (optional; default: ./Stanford Dataset)
STANFORD_CARS_ROOT=
STANFORD_CARS_DIR=
STANFORD_DATASET_ROOT=
DATASET_ROOT=

# Hardware & Execution
DEVICE=cuda                     # Options: "cuda", "cpu"
CUDA_VISIBLE_DEVICES=0
NUM_WORKERS=4
RANDOM_SEED=42

# Training & Detection Overrides
YOLO_MODEL_PATH=models/detection/yolov8n_vehicle/weights/best.pt
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45

