# =============================================================================
# Intelligent Fine-Grained Vehicle Recognition System - Environment Variables
# =============================================================================
# Copy this file to .env and configure for your deployment environment.
# Note: .env is ignored by Git and should never contain sensitive secrets or tokens.

# -----------------------------------------------------------------------------
# 1. Server & Networking Configuration
# -----------------------------------------------------------------------------
ENVIRONMENT=production          # Options: "production", "development", "testing"
PORT=8000                       # Port for FastAPI REST backend (mapped by cloud platform)
HOST=0.0.0.0                    # Host binding for API server

# Streamlit UI Configuration
STREAMLIT_SERVER_PORT=8501      # Port for Streamlit Web Dashboard
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Frontend-to-Backend Connection URL
# Set this to the public URL of the FastAPI backend in decoupled deployments.
# If empty or not set, Streamlit runs the embedded in-process pipeline.
API_URL=http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# 2. Hardware & Device Telemetry
# -----------------------------------------------------------------------------
DEVICE=auto                     # Options: "auto", "cuda", "cpu"
CUDA_VISIBLE_DEVICES=0          # GPU index (set empty string for CPU-only instances)
NUM_WORKERS=2                   # Dataloader / inference worker count
RANDOM_SEED=42

# -----------------------------------------------------------------------------
# 3. Model Weights & External Storage Strategy
# -----------------------------------------------------------------------------
# In production, models are fetched dynamically from external cloud storage
# rather than being checked into the Git repository.
MODEL_STORAGE_URL=https://github.com/skanda/intelligent-vehicle-recognition/releases/download/v1.0.0
YOLO_MODEL_PATH=models/detection/yolov8n_vehicle/weights/best.pt
CLASSIFIER_CHECKPOINT_PATH=outputs/classification/checkpoints/best_checkpoint.pt
CLASS_MAPPING_PATH=data/processed/class_mapping.json

# Detection & Classification Inference Thresholds
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
MAX_UPLOAD_SIZE_MB=25           # Maximum uploaded image file size in megabytes

# -----------------------------------------------------------------------------
# 4. Dataset Directory (Training/Offline Validation Only)
# -----------------------------------------------------------------------------
# Do NOT upload or configure raw datasets on production hosting platforms.
STANFORD_CARS_ROOT=
DATASET_ROOT=
